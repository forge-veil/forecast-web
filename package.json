{
  "name": "forecast-web",
  "version": "0.2.0",
  "description": "Time series forecasting models in the browser on WebGPU or WebAssembly, starting with Google's TimesFM 2.5. Optional React hook.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "forecasting",
    "time-series",
    "timesfm",
    "onnx",
    "webgpu",
    "browser",
    "react"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-veil/forecast-web.git"
  },
  "homepage": "https://github.com/forge-veil/forecast-web#readme",
  "bugs": {
    "url": "https://github.com/forge-veil/forecast-web/issues"
  }
}
