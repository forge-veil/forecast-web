{
  "name": "forecast-web",
  "version": "1.0.0",
  "description": "Forecasting and tabular prediction models in the browser on WebGPU or WebAssembly: TimesFM 2.5, Chronos-Bolt and TabICL. Optional React hook.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tabular": {
      "types": "./dist/tabular.d.ts",
      "import": "./dist/tabular.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "forecasting",
    "time-series",
    "time-series-forecasting",
    "anomaly-detection",
    "tabular",
    "machine-learning",
    "timesfm",
    "chronos",
    "chronos-bolt",
    "tabicl",
    "webgpu",
    "wasm",
    "onnx",
    "onnxruntime-web",
    "browser",
    "react"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-veil/forecast-web.git"
  },
  "homepage": "https://vatsalbakshi.com/forecast-web/docs/",
  "bugs": {
    "url": "https://github.com/forge-veil/forecast-web/issues"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
